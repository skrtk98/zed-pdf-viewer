[
  {
    "label": "PDF: open PDF of current file",
    "command": "mupdf-viewer",
    "args": ["$ZED_FILE"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "never",
    "hide": "on_success"
  },
  {
    "label": "PDF: open newest PDF in project",
    "command": "mupdf-viewer",
    "args": ["$ZED_WORKTREE_ROOT"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "never",
    "hide": "on_success"
  }
]
